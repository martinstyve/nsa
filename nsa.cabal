cabal-version:      3.0
name:               nsa
version:            0.1.0.0
-- synopsis:
-- description:
homepage:           nsa.martinstyve.no
license:            GPL-3.0-or-later
license-file:       LICENSE
author:             martinstyve
maintainer:         martin.styve@icloud.com
-- copyright:
category:           Web
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable nsa
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    warp
                    , base
                    , nsa
    hs-source-dirs:   app
    ghc-options: -threaded
    default-language: Haskell2010

library
    import: warnings
    hs-source-dirs: src
    exposed-modules: VDOT
                   , RaceDistance
                   , PaceRange
                   , App
                   , Html
                   , Parser
                   , RunTime
    build-depends: containers
              , aeson
              , wai
              , warp
              , base
              , lucid
              , servant
              , servant-server
              , lucid
              , servant-lucid
              , text
              , megaparsec

test-suite nsa-test
    import: warnings
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Main.hs
    other-modules: AppTests
      , PaceRangeTests
      , ParserTests
      , RunTimeTests
      , VDOTTests
    build-depends: base
                 , nsa
                 , QuickCheck
                 , tasty
                 , tasty-hunit
                 , tasty-quickcheck
                 , text
    default-language: Haskell2010
